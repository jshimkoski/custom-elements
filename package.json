{
  "name": "@jasonshimmy/custom-elements-runtime",
  "description": "A powerful, modern, and lightweight runtime for creating reactive web components with TypeScript",
  "version": "3.9.0",
  "type": "module",
  "keywords": [
    "web-components",
    "custom-elements",
    "reactive",
    "typescript",
    "frontend",
    "ui"
  ],
  "author": "Jason Shimkoski <https://jasonshimmy.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jshimkoski/custom-elements.git"
  },
  "homepage": "https://github.com/jshimkoski/custom-elements#readme",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:ci && vite build && tsc && tsc -p tsconfig.vite-plugin.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:ci": "npm run lint && npm run typecheck",
    "format": "prettier --write .",
    "all:ci": "npm run lint:ci && npm test && npm run cy && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "cy": "cypress run",
    "cy:open": "cypress open"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "cypress": "^16.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "main": "dist/custom-elements-runtime.cjs",
  "module": "dist/custom-elements-runtime.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "entities.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "typesVersions": {
    "*": {
      "ssr": [
        "./dist/ssr.d.ts"
      ],
      "transitions": [
        "./dist/transitions.d.ts"
      ],
      "directives": [
        "./dist/directives.d.ts"
      ],
      "directive-enhancements": [
        "./dist/directive-enhancements.d.ts"
      ],
      "event-bus": [
        "./dist/event-bus.d.ts"
      ],
      "store": [
        "./dist/store.d.ts"
      ],
      "router": [
        "./dist/router.d.ts"
      ],
      "css/colors": [
        "./dist/css/colors.d.ts"
      ],
      "jit-css": [
        "./dist/jit-css.d.ts"
      ],
      "dom-jit-css": [
        "./dist/dom-jit-css.d.ts"
      ],
      "vite-plugin": [
        "./dist/vite-plugin.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/custom-elements-runtime.es.js",
      "require": "./dist/custom-elements-runtime.cjs"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/custom-elements-runtime.ssr.es.js",
      "require": "./dist/custom-elements-runtime.ssr.cjs"
    },
    "./transitions": {
      "types": "./dist/transitions.d.ts",
      "import": "./dist/custom-elements-runtime.transitions.es.js",
      "require": "./dist/custom-elements-runtime.transitions.cjs"
    },
    "./directives": {
      "types": "./dist/directives.d.ts",
      "import": "./dist/custom-elements-runtime.directives.es.js",
      "require": "./dist/custom-elements-runtime.directives.cjs"
    },
    "./directive-enhancements": {
      "types": "./dist/directive-enhancements.d.ts",
      "import": "./dist/custom-elements-runtime.directive-enhancements.es.js",
      "require": "./dist/custom-elements-runtime.directive-enhancements.cjs"
    },
    "./event-bus": {
      "types": "./dist/event-bus.d.ts",
      "import": "./dist/custom-elements-runtime.event-bus.es.js",
      "require": "./dist/custom-elements-runtime.event-bus.cjs"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/custom-elements-runtime.store.es.js",
      "require": "./dist/custom-elements-runtime.store.cjs"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/custom-elements-runtime.router.es.js",
      "require": "./dist/custom-elements-runtime.router.cjs"
    },
    "./entities.json": "./entities.json",
    "./css": "./dist/style.css",
    "./css/style.css": "./dist/style.css",
    "./css/reset.css": "./dist/reset.css",
    "./css/variables.css": "./dist/variables.css",
    "./css/colors": {
      "types": "./dist/css/colors.d.ts",
      "import": "./dist/custom-elements-runtime.colors.es.js",
      "require": "./dist/custom-elements-runtime.colors.cjs"
    },
    "./jit-css": {
      "types": "./dist/jit-css.d.ts",
      "import": "./dist/custom-elements-runtime.jit-css.es.js",
      "require": "./dist/custom-elements-runtime.jit-css.cjs"
    },
    "./dom-jit-css": {
      "types": "./dist/dom-jit-css.d.ts",
      "import": "./dist/custom-elements-runtime.dom-jit-css.es.js",
      "require": "./dist/custom-elements-runtime.dom-jit-css.cjs"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/custom-elements-runtime.vite-plugin.es.js",
      "require": "./dist/custom-elements-runtime.vite-plugin.cjs"
    },
    "./ssr-middleware": {
      "types": "./dist/ssr-middleware.d.ts",
      "import": "./dist/custom-elements-runtime.ssr-middleware.es.js",
      "require": "./dist/custom-elements-runtime.ssr-middleware.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "cypress@16.0.0": true,
    "fsevents@2.3.3": true
  }
}
