{
  "name": "@jasonshimmy/custom-elements-runtime",
  "description": "A powerful, modern, and lightweight runtime for creating reactive web components with TypeScript",
  "version": "3.7.0",
  "type": "module",
  "keywords": [
    "web-components",
    "custom-elements",
    "reactive",
    "typescript",
    "frontend",
    "ui"
  ],
  "author": "Jason Shimkoski <https://jasonshimmy.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jshimkoski/custom-elements.git"
  },
  "homepage": "https://github.com/jshimkoski/custom-elements#readme",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:ci && vite build && tsc && tsc -p tsconfig.vite-plugin.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:ci": "npm run lint && npm run typecheck",
    "format": "prettier --write .",
    "all:ci": "npm run lint:ci && npm test && npm run cy && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "cy": "cypress run",
    "cy:open": "cypress open"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jsdom": "^28.0.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/coverage-v8": "^4.1.2",
    "cypress": "^15.13.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vitest": "^4.0.12"
  },
  "main": "dist/custom-elements-runtime.cjs.js",
  "module": "dist/custom-elements-runtime.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "entities.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "typesVersions": {
    "*": {
      "ssr": [
        "./dist/ssr.d.ts"
      ],
      "transitions": [
        "./dist/transitions.d.ts"
      ],
      "directives": [
        "./dist/directives.d.ts"
      ],
      "directive-enhancements": [
        "./dist/directive-enhancements.d.ts"
      ],
      "event-bus": [
        "./dist/event-bus.d.ts"
      ],
      "store": [
        "./dist/store.d.ts"
      ],
      "router": [
        "./dist/router.d.ts"
      ],
      "css/colors": [
        "./dist/css/colors.d.ts"
      ],
      "jit-css": [
        "./dist/jit-css.d.ts"
      ],
      "dom-jit-css": [
        "./dist/dom-jit-css.d.ts"
      ],
      "vite-plugin": [
        "./dist/vite-plugin.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/custom-elements-runtime.es.js",
      "require": "./dist/custom-elements-runtime.cjs.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/custom-elements-runtime.ssr.es.js",
      "require": "./dist/custom-elements-runtime.ssr.cjs.js"
    },
    "./transitions": {
      "types": "./dist/transitions.d.ts",
      "import": "./dist/custom-elements-runtime.transitions.es.js",
      "require": "./dist/custom-elements-runtime.transitions.cjs.js"
    },
    "./directives": {
      "types": "./dist/directives.d.ts",
      "import": "./dist/custom-elements-runtime.directives.es.js",
      "require": "./dist/custom-elements-runtime.directives.cjs.js"
    },
    "./directive-enhancements": {
      "types": "./dist/directive-enhancements.d.ts",
      "import": "./dist/custom-elements-runtime.directive-enhancements.es.js",
      "require": "./dist/custom-elements-runtime.directive-enhancements.cjs.js"
    },
    "./event-bus": {
      "types": "./dist/event-bus.d.ts",
      "import": "./dist/custom-elements-runtime.event-bus.es.js",
      "require": "./dist/custom-elements-runtime.event-bus.cjs.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/custom-elements-runtime.store.es.js",
      "require": "./dist/custom-elements-runtime.store.cjs.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/custom-elements-runtime.router.es.js",
      "require": "./dist/custom-elements-runtime.router.cjs.js"
    },
    "./entities.json": "./entities.json",
    "./css": "./dist/style.css",
    "./css/style.css": "./dist/style.css",
    "./css/reset.css": "./dist/reset.css",
    "./css/variables.css": "./dist/variables.css",
    "./css/colors": {
      "types": "./dist/css/colors.d.ts",
      "import": "./dist/custom-elements-runtime.colors.es.js",
      "require": "./dist/custom-elements-runtime.colors.cjs.js"
    },
    "./jit-css": {
      "types": "./dist/jit-css.d.ts",
      "import": "./dist/custom-elements-runtime.jit-css.es.js",
      "require": "./dist/custom-elements-runtime.jit-css.cjs.js"
    },
    "./dom-jit-css": {
      "types": "./dist/dom-jit-css.d.ts",
      "import": "./dist/custom-elements-runtime.dom-jit-css.es.js",
      "require": "./dist/custom-elements-runtime.dom-jit-css.cjs.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/custom-elements-runtime.vite-plugin.es.js",
      "require": "./dist/custom-elements-runtime.vite-plugin.cjs.js"
    },
    "./ssr-middleware": {
      "types": "./dist/ssr-middleware.d.ts",
      "import": "./dist/custom-elements-runtime.ssr-middleware.es.js",
      "require": "./dist/custom-elements-runtime.ssr-middleware.cjs.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
