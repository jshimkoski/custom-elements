{
  "name": "@jasonshimmy/custom-elements-runtime",
  "description": "A powerful, modern, and lightweight runtime for creating reactive web components with TypeScript",
  "version": "2.2.0",
  "type": "module",
  "keywords": [
    "web-components",
    "custom-elements",
    "reactive",
    "typescript",
    "frontend",
    "ui"
  ],
  "author": "Jason Shimkoski <https://jasonshimmy.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jshimkoski/custom-elements.git"
  },
  "homepage": "https://github.com/jshimkoski/custom-elements#readme",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:ci && vite build && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:ci": "npm run lint && npm run typecheck",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "cy": "cypress run",
    "cy:open": "cypress open"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jsdom": "^27.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/coverage-v8": "^3.2.4",
    "cypress": "^15.5.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "main": "dist/custom-elements-runtime.cjs.js",
  "module": "dist/custom-elements-runtime.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist/index.d.ts",
    "dist/*.d.ts",
    "entities.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/custom-elements-runtime.es.js",
      "require": "./dist/custom-elements-runtime.cjs.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/custom-elements-runtime.ssr.es.js",
      "require": "./dist/custom-elements-runtime.ssr.cjs.js"
    },
    "./transitions": {
      "types": "./dist/transitions.d.ts",
      "import": "./dist/custom-elements-runtime.transitions.es.js",
      "require": "./dist/custom-elements-runtime.transitions.cjs.js"
    },
    "./directives": {
      "types": "./dist/directives.d.ts",
      "import": "./dist/custom-elements-runtime.directives.es.js",
      "require": "./dist/custom-elements-runtime.directives.cjs.js"
    },
    "./directive-enhancements": {
      "types": "./dist/directive-enhancements.d.ts",
      "import": "./dist/custom-elements-runtime.directive-enhancements.es.js",
      "require": "./dist/custom-elements-runtime.directive-enhancements.cjs.js"
    },
    "./event-bus": {
      "types": "./dist/event-bus.d.ts",
      "import": "./dist/custom-elements-runtime.event-bus.es.js",
      "require": "./dist/custom-elements-runtime.event-bus.cjs.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/custom-elements-runtime.store.es.js",
      "require": "./dist/custom-elements-runtime.store.cjs.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/custom-elements-runtime.router.es.js",
      "require": "./dist/custom-elements-runtime.router.cjs.js"
    },
    "./entities.json": "./entities.json",
    "./css": "./dist/style.css",
    "./css/style.css": "./dist/style.css",
    "./css/reset.css": "./dist/reset.css",
    "./css/variables.css": "./dist/variables.css"
  },
  "publishConfig": {
    "access": "public"
  }
}
